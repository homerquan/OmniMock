{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnimock.dev/schemas/cli-manifest.schema.json",
  "title": "OmniMock CLI Manifest",
  "type": "object",
  "required": ["schema_version", "kind", "id", "commands"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1"},
    "kind": {"const": "cli"},
    "id": {"type": "string", "minLength": 1},
    "limits": {
      "type": "object",
      "properties": {
        "max_arg_count": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_arg_length": {"type": "integer", "minimum": 1, "maximum": 65536},
        "max_stdout_bytes": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "max_stderr_bytes": {"type": "integer", "minimum": 0, "maximum": 1000000}
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "args", "response"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "args": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "allow_extra_args": {"type": "boolean"},
          "response": {
            "type": "object",
            "required": ["exit_code", "stdout"],
            "properties": {
              "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
              "stdout": true,
              "stderr": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
